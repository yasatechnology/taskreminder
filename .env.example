# ============================================================
# TASKREMIND - Environment Variables
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# --- Supabase (Frontend - Public) ---
# URL proyek Supabase Anda (Temukan di: Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Kunci anonim publik Supabase (Temukan di: Settings > API > anon/public)
# Kunci ini AMAN diletakkan di frontend karena dilindungi RLS
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Telegram Bot (Frontend - Public) ---
# Username bot Telegram Anda (tanpa @), untuk membuat tautan deep-link
# Dapatkan dari BotFather di Telegram
VITE_TELEGRAM_BOT_USERNAME=YourBotUsernameBot

# ============================================================
# PERINGATAN KEAMANAN:
# Variabel di bawah ini HANYA boleh diset sebagai Supabase
# Edge Function Secrets dan TIDAK BOLEH ada di file .env frontend!
#
# Cara set: supabase secrets set KEY=value
# ============================================================

# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
